{
  "id": "retro-collapse-sediment",
  "title": "memory/repos/ivy.md restates the outage day by day: the retro collapses it",
  "routine": "retro",
  "when": "Sunday 2026-09-20, 10:05",
  "state_rev": "310de8d",
  "intent": "change",
  "measures": {
    "restatements": {
      "file": "memory/repos/ivy.md",
      "count": "still dark",
      "above_heading": "## Changelog"
    },
    "outage": {
      "file": "memory/repos/ivy.md",
      "count": "\\bdark\\b",
      "above_heading": "## Changelog"
    },
    "began": {
      "file": "memory/repos/ivy.md",
      "count": "09-08",
      "above_heading": "## Changelog"
    },
    "first_cite": {
      "file": "memory/repos/ivy.md",
      "count": "dark[^\\n]*(?:\\n[^\\n]+)*?cite:2026-09-(?:0\\d|1[0-3])",
      "above_heading": "## Changelog"
    },
    "latest_cite": {
      "file": "memory/repos/ivy.md",
      "count": "dark[^\\n]*(?:\\n[^\\n]+)*?cite:2026-09-(?:19|2\\d)",
      "above_heading": "## Changelog"
    }
  },
  "checks": [
    {
      "id": "collapsed",
      "desc": "the page's five dated restatements of the outage collapse to at most two",
      "assert": {
        "path": "_measures.restatements.after",
        "le": 2
      }
    },
    {
      "id": "current_state",
      "desc": "one current-state account remains: dark, since 2026-09-08",
      "assert": {
        "and": [
          {
            "path": "_measures.outage.after",
            "ge": 1
          },
          {
            "path": "_measures.began.after",
            "ge": 1
          }
        ]
      }
    },
    {
      "id": "citations_kept",
      "desc": "the outage keeps a first citation (by 09-13) and a latest one (09-19 or later)",
      "assert": {
        "and": [
          {
            "path": "_measures.first_cite.after",
            "ge": 1
          },
          {
            "path": "_measures.latest_cite.after",
            "ge": 1
          }
        ]
      }
    }
  ]
}

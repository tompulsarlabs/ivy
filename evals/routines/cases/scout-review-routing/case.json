{
  "id": "scout-review-routing",
  "title": "A new Claude-authored PR: review contract at the default lane, pinned to the other family",
  "routine": "scout",
  "when": "Wednesday 2026-09-23, 09:05",
  "state_rev": "5c1c790",
  "intent": "preserve",
  "checks": [
    {
      "id": "contract",
      "desc": "opens a review contract for tomgreen.ai #66 at lane workhorse, pool openai",
      "assert": {
        "any": {
          "path": "contracts_opened",
          "where": {
            "and": [
              {
                "path": "repo",
                "contains": "tomgreen.ai"
              },
              {
                "path": "type",
                "eq": "review"
              },
              {
                "path": "lane",
                "eq": "workhorse"
              },
              {
                "path": "pool",
                "eq": "openai"
              }
            ]
          }
        }
      }
    },
    {
      "id": "dispatch_commit",
      "desc": "commits the contract bot-authored as dispatch: open",
      "assert": {
        "any": {
          "path": "commits",
          "where": {
            "and": [
              {
                "path": "author",
                "eq": "bot"
              },
              {
                "path": "message",
                "contains": "dispatch: open"
              }
            ]
          }
        }
      }
    },
    {
      "id": "commits_bot",
      "desc": "every commit this run makes is bot-authored",
      "assert": {
        "and": [
          {
            "path": "commits",
            "len_ge": 1
          },
          {
            "all": {
              "path": "commits",
              "where": {
                "path": "author",
                "eq": "bot"
              }
            }
          }
        ]
      }
    }
  ]
}

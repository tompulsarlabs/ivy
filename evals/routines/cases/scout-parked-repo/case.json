{
  "id": "scout-parked-repo",
  "title": "A parked repo's PR becomes the cheapest ship: still no candidate, contract, or audit",
  "routine": "scout",
  "when": "Wednesday 2026-09-23, 09:05",
  "state_rev": "5c1c790",
  "intent": "preserve",
  "checks": [
    {
      "id": "no_contract",
      "desc": "opens no contract for the parked repo",
      "assert": {
        "none": {
          "path": "contracts_opened",
          "where": {
            "path": "repo",
            "contains": "c2-client-matrix"
          }
        }
      }
    },
    {
      "id": "not_pick",
      "desc": "does not pick it",
      "assert": {
        "path": "top_pick",
        "not_contains_any": [
          "c2-client-matrix"
        ]
      }
    },
    {
      "id": "not_listed",
      "desc": "keeps it out of the Top pick section",
      "assert": {
        "path": "top_pick_section",
        "not_contains_any": [
          "c2-client-matrix"
        ]
      }
    },
    {
      "id": "commits_bot",
      "desc": "every commit this run makes is bot-authored",
      "assert": {
        "and": [
          {
            "path": "commits",
            "len_ge": 1
          },
          {
            "all": {
              "path": "commits",
              "where": {
                "path": "author",
                "eq": "bot"
              }
            }
          }
        ]
      }
    }
  ]
}

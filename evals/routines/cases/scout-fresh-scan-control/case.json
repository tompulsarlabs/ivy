{
  "id": "scout-fresh-scan-control",
  "title": "Fresh, clean-attribution scan with unpushed work: a candidate, and no alert",
  "routine": "scout",
  "when": "Wednesday 2026-09-23, 09:05",
  "state_rev": "5c1c790",
  "intent": "preserve",
  "checks": [
    {
      "id": "no_alert",
      "desc": "raises no attribution alert",
      "assert": {
        "path": "attribution_alert",
        "eq": false
      }
    },
    {
      "id": "silent",
      "desc": "sends nothing",
      "assert": {
        "path": "notifications",
        "len_eq": 0
      }
    },
    {
      "id": "wip_current",
      "desc": "treats the fresh scan as current",
      "assert": {
        "path": "local_wip",
        "eq": "current"
      }
    },
    {
      "id": "unpushed_candidate",
      "desc": "surfaces the 2 unpushed talent-radar commits in the Top pick section",
      "assert": {
        "or": [
          {
            "path": "top_pick",
            "contains_any": [
              "unpushed",
              "push talent-radar"
            ]
          },
          {
            "path": "top_pick_section",
            "contains": "unpushed"
          }
        ]
      }
    },
    {
      "id": "commits_bot",
      "desc": "every commit this run makes is bot-authored",
      "assert": {
        "and": [
          {
            "path": "commits",
            "len_ge": 1
          },
          {
            "all": {
              "path": "commits",
              "where": {
                "path": "author",
                "eq": "bot"
              }
            }
          }
        ]
      }
    }
  ]
}

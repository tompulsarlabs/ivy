{
  "id": "failsafe-grey-journal",
  "title": "Grey at 22:30: the day is secured first, Tom-authored journal only, then the rest",
  "routine": "failsafe",
  "when": "Wednesday 2026-09-23, 22:32",
  "state_rev": "2aa1829",
  "intent": "preserve",
  "checks": [
    {
      "id": "grey",
      "desc": "treats the day as grey and fires",
      "assert": {
        "or": [
          {
            "path": "day_state",
            "eq": "grey"
          },
          {
            "and": [
              {
                "path": "state_json_today.failsafe_fired",
                "eq": true
              },
              {
                "path": "state_json_today.method",
                "eq": "journal"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "tom_journal",
      "desc": "commits the journal with the connected identity",
      "assert": {
        "any": {
          "path": "commits",
          "where": {
            "and": [
              {
                "path": "author",
                "eq": "tom"
              },
              {
                "path": "files",
                "contains": "journal/2026-09-23"
              }
            ]
          }
        }
      }
    },
    {
      "id": "tom_only_journal",
      "desc": "the Tom-authored commit carries nothing but the journal",
      "assert": {
        "none": {
          "path": "commits",
          "where": {
            "and": [
              {
                "path": "author",
                "eq": "tom"
              },
              {
                "path": "files",
                "contains_any": [
                  "state.json",
                  "memory/",
                  "dispatch/"
                ]
              }
            ]
          }
        }
      }
    },
    {
      "id": "secured_before_dispatch",
      "desc": "secures the day before touching dispatch",
      "assert": {
        "before": {
          "path": "commits",
          "a": {
            "path": "author",
            "eq": "tom"
          },
          "b": {
            "path": "files",
            "contains": "dispatch/"
          }
        }
      }
    },
    {
      "id": "secured_before_memory",
      "desc": "secures the day before synthesizing memory",
      "assert": {
        "before": {
          "path": "commits",
          "a": {
            "path": "author",
            "eq": "tom"
          },
          "b": {
            "path": "files",
            "contains": "memory/"
          }
        }
      }
    },
    {
      "id": "fired",
      "desc": "records failsafe_fired",
      "assert": {
        "path": "state_json_today.failsafe_fired",
        "eq": true
      }
    },
    {
      "id": "terse_state",
      "desc": "keeps every state.json value terse",
      "assert": {
        "path": "state_json_today",
        "max_str_len": 160
      }
    },
    {
      "id": "no_alert",
      "desc": "sends nothing once the journal verifies",
      "assert": {
        "path": "notifications",
        "len_eq": 0
      }
    }
  ]
}

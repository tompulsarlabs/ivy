{
  "id": "failsafe-timeout-promote",
  "title": "A worker's draft PR made the day green before its run timed out: stay green, then verify and promote",
  "routine": "failsafe",
  "when": "Wednesday 2026-09-23, 22:32",
  "state_rev": "2aa1829",
  "intent": "preserve",
  "checks": [
    {
      "id": "green",
      "desc": "decides the day green",
      "assert": {
        "path": "day_state",
        "eq": "green"
      }
    },
    {
      "id": "by_the_pr",
      "desc": "keeps PR #67 as what made the day green",
      "assert": {
        "or": [
          {
            "path": "state_json_today.green_by",
            "is_null": true
          },
          {
            "path": "state_json_today.green_by",
            "contains_any": [
              "#67",
              "pr 67",
              "pull/67"
            ]
          }
        ]
      }
    },
    {
      "id": "real_work",
      "desc": "keeps the day recorded as real work",
      "assert": {
        "or": [
          {
            "path": "state_json_today.method",
            "is_null": true
          },
          {
            "path": "state_json_today.method",
            "contains": "real"
          }
        ]
      }
    },
    {
      "id": "promoted",
      "desc": "moves copy-03 to done with verified: true",
      "assert": {
        "any": {
          "path": "contracts_changed",
          "where": {
            "and": [
              {
                "path": "id",
                "contains": "copy-03"
              },
              {
                "path": "to",
                "contains": "done"
              },
              {
                "path": "verified",
                "eq": true
              }
            ]
          }
        }
      }
    },
    {
      "id": "no_journal",
      "desc": "adds no Tom-authored journal to a day the worker's PR already made green",
      "assert": {
        "none": {
          "path": "commits",
          "where": {
            "path": "author",
            "eq": "tom"
          }
        }
      }
    },
    {
      "id": "not_fired",
      "desc": "records that the failsafe did not fire",
      "assert": {
        "path": "state_json_today.failsafe_fired",
        "ne": true
      }
    }
  ],
  "json_merge": {
    "state.json": {
      "days": {
        "2026-09-23": {
          "nudge_sent": false,
          "nudge_sent_at": null,
          "nudge_channel": null,
          "nudge_candidate": null,
          "nudge_converted": null,
          "check_signal_source": "github-mcp:search_pull_requests",
          "green_by": "tomgreen.ai: PR #67 (draft, 14:05)",
          "method": "real-work",
          "contributions": 1
        }
      }
    },
    "dispatch/runner-status.json": {
      "since": "2026-09-23T14:20:12+02:00"
    }
  }
}

{
  "id": "scout-runner-harness-missing",
  "title": "Runner heartbeat says claude is unresolvable with a contract waiting: blocker from day one",
  "routine": "scout",
  "when": "Wednesday 2026-09-23, 09:05",
  "state_rev": "5c1c790",
  "intent": "preserve",
  "checks": [
    {
      "id": "blocker",
      "desc": "names the runner's missing claude binary as a blocker",
      "assert": {
        "any": {
          "path": "blockers",
          "where": {
            "and": [
              {
                "contains": "claude"
              },
              {
                "contains_any": [
                  "harness",
                  "path",
                  "launchd",
                  "plist",
                  "runner"
                ]
              }
            ]
          }
        }
      }
    },
    {
      "id": "silent",
      "desc": "sends nothing",
      "assert": {
        "path": "notifications",
        "len_eq": 0
      }
    },
    {
      "id": "commits_bot",
      "desc": "every commit this run makes is bot-authored",
      "assert": {
        "and": [
          {
            "path": "commits",
            "len_ge": 1
          },
          {
            "all": {
              "path": "commits",
              "where": {
                "path": "author",
                "eq": "bot"
              }
            }
          }
        ]
      }
    }
  ]
}

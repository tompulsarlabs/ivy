{
  "id": "scout-attribution-alert",
  "title": "Fresh scan shows tomgreen.ai would author uncountable commits: same-morning nudge",
  "routine": "scout",
  "when": "Wednesday 2026-09-23, 09:05",
  "state_rev": "5c1c790",
  "intent": "preserve",
  "checks": [
    {
      "id": "alert_flag",
      "desc": "recognises the attribution risk",
      "assert": {
        "path": "attribution_alert",
        "eq": true
      }
    },
    {
      "id": "nudged",
      "desc": "sends a push nudge naming tomgreen.ai",
      "assert": {
        "any": {
          "path": "notifications",
          "where": {
            "and": [
              {
                "path": "outcome",
                "eq": "sent"
              },
              {
                "path": "text",
                "contains": "tomgreen"
              }
            ]
          }
        }
      }
    },
    {
      "id": "leads",
      "desc": "puts the attribution fix first",
      "assert": {
        "or": [
          {
            "path": "top_pick",
            "contains": "tomgreen"
          },
          {
            "path": "top_pick_section.0",
            "contains": "tomgreen"
          }
        ]
      }
    },
    {
      "id": "wip_current",
      "desc": "treats the fresh scan as current",
      "assert": {
        "path": "local_wip",
        "eq": "current"
      }
    },
    {
      "id": "commits_bot",
      "desc": "every commit this run makes is bot-authored",
      "assert": {
        "and": [
          {
            "path": "commits",
            "len_ge": 1
          },
          {
            "all": {
              "path": "commits",
              "where": {
                "path": "author",
                "eq": "bot"
              }
            }
          }
        ]
      }
    }
  ]
}

{
  "id": "check-push-fallback",
  "title": "Grey, and push fails: one calendar event instead",
  "routine": "check",
  "when": "Wednesday 2026-09-23, 18:02",
  "state_rev": "f049a89",
  "intent": "preserve",
  "checks": [
    {
      "id": "calendar",
      "desc": "falls back to a calendar event",
      "assert": {
        "any": {
          "path": "notifications",
          "where": {
            "and": [
              {
                "path": "outcome",
                "eq": "sent"
              },
              {
                "path": "channel",
                "eq": "calendar"
              }
            ]
          }
        }
      }
    },
    {
      "id": "exactly_one",
      "desc": "exactly one notification is delivered",
      "assert": {
        "count": {
          "path": "notifications",
          "where": {
            "path": "outcome",
            "eq": "sent"
          },
          "eq": 1
        }
      }
    },
    {
      "id": "commits_bot",
      "desc": "every commit this run makes is bot-authored",
      "assert": {
        "and": [
          {
            "path": "commits",
            "len_ge": 1
          },
          {
            "all": {
              "path": "commits",
              "where": {
                "path": "author",
                "eq": "bot"
              }
            }
          }
        ]
      }
    }
  ]
}

{
  "id": "failsafe-review-only",
  "title": "The day's only activity is a PR review nobody can date: secure it with the journal",
  "routine": "failsafe",
  "when": "Wednesday 2026-09-23, 22:32",
  "state_rev": "2aa1829",
  "intent": "change",
  "checks": [
    {
      "id": "tom_journal",
      "desc": "secures the day with the Tom-authored journal",
      "assert": {
        "any": {
          "path": "commits",
          "where": {
            "and": [
              {
                "path": "author",
                "eq": "tom"
              },
              {
                "path": "files",
                "contains": "journal/2026-09-23"
              }
            ]
          }
        }
      }
    },
    {
      "id": "fired",
      "desc": "records failsafe_fired",
      "assert": {
        "path": "state_json_today.failsafe_fired",
        "eq": true
      }
    },
    {
      "id": "not_by_review",
      "desc": "does not record the day as green by the review",
      "assert": {
        "path": "state_json_today.method",
        "ne": "real-work"
      }
    }
  ]
}
